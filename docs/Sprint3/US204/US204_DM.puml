@startuml
'https://plantuml.com/class-diagram

class Ship {
-MMSI
-name
-IMO
-nrGenerators
-pwrOutput
-callSign
-vesselType
-length
-width
-capacity
-draft
}

class Container {
-containerId
-containerPayload
-containerTare
-containerGross
-ISOcode
}

class CargoManifest {
-content
-elaborationDate
}

class Port{
-idPort
-name
-continent
-country
-latitude
-longitude
}

class LoadingCargoManifest {
}

class UnloadingCargoManifest {
}

Ship "1" -- "*" Container : carries >
Port "1" -- "*" Container: stores >
CargoManifest "1" -l- "*" Container : contains >
LoadingCargoManifest "1" -u- "1" CargoManifest : is a >
UnloadingCargoManifest "*" -u- "1" CargoManifest : is a >

@enduml