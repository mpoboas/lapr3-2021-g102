@startuml
'https://plantuml.com/class-diagram

class Company {
-designation
+getShipStore()
}

class ClosestPortUI {
}

class FindClosestPortController {
+getShipCoordinatesAtGivenTime(Ship ship, DateTime dateTime)
+findClosestPort(Coordinates coordinates)
}

class ShipStore {
BST<Ship> shipTree
+getShipCoordinatesAtGivenTime(Ship ship, DateTime dateTime)
}

class ShipTree {
getShipCoordinatesAtGivenTime(Ship ship, DateTime dateTime)
}

class Ship {
-MMSI
-vesselName
-IMO
-callSign
-vesselType
-length
-width
-draft
-cargo
-transceiverClass
}

class PortStore {
BST<Port> portTree
+findClosestPort(Coordinates coordinates)
}

class Port {
-id
-name
-continent
-country
-coordinates
}

ClosestPortUI ..> FindClosestPortController
Company -> PortStore : adopts >
PortStore "1" ->  "*" Port: stores >
ShipStore "1" ->  "*" ShipTree: has >
ShipTree "1" ->  "*" Ship: stores >
FindClosestPortController ..> Company
FindClosestPortController ..> PortStore
FindClosestPortController ..> ShipStore

@enduml