@startuml
autonumber
'hide footbox
actor "Ship Captain" as SC

participant ":FindClosestPortUI" as UI
participant ":FindClosestPortController" as CTRL
participant "Company" as COMP
participant "ship: Ship" as SHIP
participant "portStore : PortStore" as PSTORE
participant "shipStore: ShipStore" as SSTORE
participant "PortTree" as PORTTREE
'participant "TripTree" as TRIPTREE



activate SC
SC -> UI : asks for the closest port to a ship
activate UI
UI --> SC : asks to choose a ship (callSign
deactivate UI

SC -> UI : inserts requested data
activate UI

UI -> CTRL : findClosestPort(callSign, dateTime)
activate CTRL
CTRL -> COMP : shipStore = getShipStore()
activate COMP
deactivate COMP

CTRL -> COMP : portStore = getPortStore()
activate COMP
COMP -> PSTORE : PortTree = getPortTree()
activate PSTORE
deactivate PSTORE
deactivate COMP

CTRL -> SSTORE : getShipByCallSign(callSign)
activate SSTORE
deactivate SSTORE

CTRL -> CTRL : getShipCoordinatesAtGivenTime(ship, dateTime)
activate CTRL
CTRL -> SHIP : getAISAtDateTime(dateTime)
activate SHIP
deactivate SHIP

CTRL -> SHIP : getCoordinates()
activate SHIP
deactivate SHIP
deactivate



CTRL --> UI
deactivate CTRL
UI --> SC
deactivate UI
deactivate SC


@enduml