@startuml
'https://plantuml.com/class-diagram

class Company {
-designation
+getShipStore()
}

class ShipStore{
-ShipTree shipTreeMMSI
-ShipTree shipTreeIMO
-ShipTree shipTreeCallSign
+createShip(MMSI,vesselName,IMO,callSign,vesselType,\nlength,width,draft,cargo,transceiverClass)
+validadeShip(ship)
+addShip(ship)
+getShipByMMSI(MMSI)
+getShipByIMO(IMO)
+getShipByCallSign(callSign)
+getCloseCoordsShips()
}


class Ship{
-MMSI
-vesselName
-IMO
-callSign
-vesselType
-length
-width
-draft
-cargo
-transceiverClass
+Ship(MMSI,vesselName,IMO,callSign,vesselType,\nlength,width,draft,cargo,transceiverClass)
+addAISMessage(aisMessage)
+getAISAtDate(date)
+getAISBetweenTwoDates(date1, date2)
+getVesselName()
+getStartBDT()
+getEndBDT()
+getTotalTimeInSea()
+numberOfMovements()
+getMaxSOG()
+getMeanSOG()
+getMaxCOG()
+getMeanCOG()
+getDepartureLatitude()
+getDepartureLongitude()
+getArrivalLatitude()
+getArrivalLongitude()
+getTotalDistance()
+deltaDistance()
}

class ShipTree{
-Comparator<Ship> comp;
+ShipTree(type);
+insert(ship);
+remove(ship);
+find(ship);
+equals(Object);
+getShipByMMSI(MMSI);
+getShipByIMO(IMO);
+getShipByCallSign(callSign);
+getCloseCoordsShips();
}
class AISMessage{
-dateTime
-latitude
-longitude
-SOG
-COG
-heading
+AISMessage(dateTime,latitude,longitude,\nSOG,COG,heading)
}
