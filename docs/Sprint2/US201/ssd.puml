@startuml
actor "Port Manager" as Pman
participant System as sys
activate Pman
Pman -> sys : Requests 2d tree of ports
activate sys
sys -->Pman : Asks for file with Port information
deactivate sys
Pman -> sys :inserts file name
activate sys
sys --> Pman :shows 2d Tree of ports
deactivate sys
deactivate Pman
@enduml