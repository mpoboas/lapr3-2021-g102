@startuml
actor "Ship Captain" as sc
participant getNManifestsYUI as UI
participant getNManifestsYController as Controller
participant getNManifestsYear as data
participant ConnectionFactory as cf
participant DatabaseConnection as dc

database LAPR3_G102  as db

autonumber
activate sc
sc -> UI: Requests how many cargo manifests he has transported in a given year and average container
activate UI
UI --> sc : Requests which year is desired
deactivate UI
sc ->UI : types requested data
activate UI
UI --> sc : Shows the desired numbers
deactivate UI
deactivate sc


@enduml