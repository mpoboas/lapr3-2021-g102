@startuml
autonumber
'hide footbox

actor "Ship Captain" as SC

participant "ShipOccupancyRateUI" as UI
participant "GetShipOccupancyRateController" as CTRL
participant "ShipOccupancyRate" as SHIPOCCRATE
participant ConnectionFactory as CF
participant DatabaseConnection as DC
database LAPR3_G102 as DB

activate SC
SC -> UI : requests the occupancy rate of a given ship at a given moment
activate UI
UI --> SC : requests all the needed data (ship and moment)
deactivate UI

SC -> UI : types data
activate UI

UI -> CF** : create()
activate CF
CF -> DC** : create()
activate DC
DC --> DB
deactivate DC
deactivate CF

UI -> CTRL : getShipOccupancyRateById(connectionFactory, shipMMSI, localDateTimeStr)
activate CTRL
CTRL -> SHIPOCCRATE** : create(connectionFactory, shipMMSI, localDateTimeStr)
activate SHIPOCCRATE
CTRL -> SHIPOCCRATE : getShipOccupancyRate()

SHIPOCCRATE -> CF : getShipIdByMMSI(shipMMSI)
activate CF
CF --> DC : establishes connection
activate DC
DC --> DB : runs query
DB --> DC : query results
DC --> CF
deactivate DC
CF --> SHIPOCCRATE

deactivate CF
SHIPOCCRATE -> CF : getCargoManifestIdByDateTime(localDateTimeStr)
activate CF
CF --> DC : establishes connection
activate DC
DC --> DB : runs query
DB --> DC : query results
DC --> CF
deactivate DC
CF --> SHIPOCCRATE
deactivate CF

SHIPOCCRATE -> CF : calcShipOccupancyRate()
activate CF
CF --> DC : establishes connection
activate DC
DC --> DB : runs query
DB --> DC : query results
DC --> CF
deactivate DC
CF --> SHIPOCCRATE
deactivate CF

SHIPOCCRATE --> CTRL
deactivate SHIPOCCRATE
CTRL --> UI
deactivate CTRL
UI --> SC : shows the given ship´s occupancy rate
deactivate UI
@enduml