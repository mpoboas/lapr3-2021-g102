@startuml
autonumber
'hide footbox
actor "Traffic Manager" as TF

participant ":ShipDetailUI" as UI
participant ":ShipDetailController" as CTRL
participant ":Company" as COMP
participant "store :ShipStore" as STR
participant ":ShipMapper" as MPR1
participant "shipDto: ShipDTO" as DTO
participant "ship :Ship" as ship


activate TF
TF -> UI : asks to search the details of a ship
activate UI
UI --> TF : requests data (MMSI or IMO or callSign )
deactivate UI

TF -> UI : inserts requested data
activate UI
alt inserted ship's mmsi

UI -> CTRL: shipDto = getShipByMMSI(shipMMSI)
activate CTRL
CTRL -> COMP: store = getShipStore()
activate COMP
deactivate COMP
CTRL -> STR: ship = getShipByMMSI(shipMMSI)
activate STR
deactivate STR
CTRL -> MPR1: shipDto = toDTO(ship)
activate MPR1
deactivate MPR1
deactivate CTRL

else inserted ship's imo
UI -> CTRL: shipDto = getShipByIMO(shipIMO)
activate CTRL
CTRL -> COMP: store = getShipStore()
activate COMP
deactivate COMP
CTRL -> STR: ship = getShipByIMO(shipIMO)
activate STR
deactivate STR
CTRL -> MPR1: shipDto = toDTO(ship)
activate MPR1
deactivate MPR1
deactivate CTRL

else inserted ship's call sign
UI -> CTRL: shipDto = getShipByCallSign(shipCallSign)
activate CTRL
CTRL -> COMP: store = getShipStore()
activate COMP
deactivate COMP
CTRL -> STR: ship = getShipByCallSign(shipCallSign)
activate STR
deactivate STR
CTRL -> MPR1: shipDto = toDTO(ship)
activate MPR1
deactivate MPR1
deactivate CTRL
end

UI --> TF : shows the ship information
deactivate UI


TF -> UI : confirms the data
activate UI
UI --> TF : informs operation success
deactivate UI

deactivate TF


@enduml