@startuml
autonumber
'hide footbox
actor "Traffic Manager" as TF

participant ":SummaryUI" as UI
participant ":SummaryController" as CTRL
participant "Ship" as COMP
participant "ship: Ship"


activate TF
TF -> UI : aks to see a summary of a ship's movements
activate UI
UI --> TF : asks to choose a ship (MMSI or IMO or callSign)
deactivate UI

TF -> UI : inserts requested data
activate UI

UI -> CTRL : getShipSummary(ship)
activate CTRL

CTRL -> CTRL : getShip()
activate CTRL
deactivate CTRL

CTRL -> COMP :getVesselName()
activate COMP
deactivate COMP

CTRL -> COMP : getStartBDT()
activate COMP
deactivate COMP

CTRL -> COMP : getEndBDT()
activate COMP
deactivate COMP

CTRL -> COMP : getTotalTimeInSea()
activate COMP
deactivate COMP

CTRL -> COMP : numberOfMovements()
activate COMP
deactivate COMP

CTRL -> COMP : getMaxSOG()
activate COMP
deactivate COMP

CTRL -> COMP : getMeanSOG()
activate COMP
deactivate COMP

CTRL -> COMP : getMaxCOG()
activate COMP
deactivate COMP

CTRL -> COMP : getMeanCOG()
activate COMP
deactivate COMP

CTRL -> COMP : getDepartureLatitude()
activate COMP
deactivate COMP

CTRL -> COMP : getDepartureLongitude()
activate COMP
deactivate COMP

CTRL -> COMP : getArrivalLatitude()
activate COMP
deactivate COMP

CTRL -> COMP : getArrivalLongitude()
activate COMP
deactivate COMP

CTRL -> COMP : getTotalDistance()
activate COMP
deactivate COMP

CTRL -> COMP : deltaDistance()
activate COMP
deactivate COMP


CTRL --> UI
deactivate CTRL
UI --> TF : shows summary of the selected ship's movement's
deactivate UI
deactivate TF


@enduml