@startuml

class Ship {
-MMSI
-name
-IMO
-nrGenerators
-pwrOutput
-callSign
-vesselType
-length
-width
-capacity
-draft
-baseDateTime
-latitude
-longitude
-SOG
-COG
-heading
-position
-transceiverClass
}

class Container {
-containerId
-containerPayload
-containerTare
-containerGross
-ISOcode
}

class CargoManifest {
-content
-elaborationDate
}

class LoadingCargoManifest {
}

class UnloadingCargoManifest {
}

class Client {
}

class Trips{
-startingPort
-destination
-CoordinatesSet
}

class Port {
-idPort
-name
-continent
-country
-latitude
-longitude
}

Client "*" -u- "*" Container : leases >
Ship "1" -- "*" Trips : does many >
Ship "1" -- "*" Container : carries >
CargoManifest "*" -l- "*" Container : contains >
LoadingCargoManifest "1" -u- "1" CargoManifest : is a >
UnloadingCargoManifest "*" -u- "1" CargoManifest : is a >
Trips "1" -- "*" Port : between >

@enduml