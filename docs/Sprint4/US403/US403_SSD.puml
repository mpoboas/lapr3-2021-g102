@startuml
'https://plantuml.com/sequence-diagram

autonumber

actor "Traffic Manager" as TF

activate TF
TF -> ":System" : asks to get the most efficient circuit
activate ":System"

":System" --> TF : shows the list of locations of the circuit
deactivate ":System"


TF -> ":System" : confirms the data
activate ":System"
":System" --> TF : informs operation success
deactivate ":System"

deactivate TF
@enduml