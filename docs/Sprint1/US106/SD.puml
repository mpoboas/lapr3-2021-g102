@startuml
actor user as usr
participant  listShipsUI as UI
participant listShipsController as Controller
participant shipList as sl
participant ship as ship
participant AISMessage as AISMessage
autonumber
activate usr
usr -> UI : requests ships with most kilometers travelled and average speed
activate UI
UI --> usr : requests how many ships must be listed and period of time
deactivate UI
usr -> UI: types how many ships will be listed and period of time
activate UI
UI -> Controller : Requests list of top n ships with most kilometers and average speed in that period
activate Controller
Controller -> sl : requests top n ships with the requested stats
activate sl
sl -> ship : requests distance done and total time driven by each ship
activate ship
ship -> AISMessage: requests distance of each ship's AISMessage and duration
activate AISMessage
AISMessage --> AISMessage : calculates distance in between AISMessages in period required
activate AISMessage
deactivate AISMessage
AISMessage --> ship: sends requested data
deactivate AISMessage
ship -->ship : calculates total time driven and total distance
activate ship
deactivate ship
ship --> sl : send sum of ship total AISMessage distance and average speed
deactivate ship
sl --> Controller : sends list
Controller -->Controller : filters the top n ships and orders them
activate Controller
deactivate Controller
deactivate sl
Controller --> UI :  sends list
deactivate Controller
UI --> usr : shows the list requested
deactivate UI
deactivate usr
@enduml