@startuml
actor "traffic manager" as actor
participant  listShipsUI as UI
participant listShipsController as Controller
participant ShipList as sl
participant ships as s
participant travel as t
autonumber
activate actor
actor -> UI : Requests  a list for all ships(MMSI, total number of movements, Travelled Distance and Delta Distance).
sys --> actor : asks about order of list and which field willl order list
deactivate sys
actor ->sys : Types requested data
activate sys
activate UI
UI -> Controller : requests ship list with required paramters
activate Controller
Controller -> sl : requests ships info
activate sl
sl -> s :requests ships number of movements, travelled distance and delta distance.
activate s
s -> t : requests distance for each of the trips done by the ship
activate t
t --> t : calculates each trip's distance
activate t
deactivate t
t --> s: sends requested data
deactivate t
s --> s :calculates the required parameters
activate s
deactivate s
s --> sl : sends required parameters
deactivate s
sl --> Controller : sends list of ships
deactivate sl
Controller --> UI : sends list of ships
deactivate Controller
UI --> actor : Shows requested list
deactivate UI
deactivate actor
@enduml